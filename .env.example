# OfferGraph environment variables. Copy to .env.local for local dev; set the same names in
# Vercel -> Project offergraph -> Settings -> Environment Variables for deployments.
# All of these are read only by the server functions in api/. Never prefix them with VITE_
# (that would put them in the browser bundle).

# Redis (Upstash): cache, rate limits, live search analytics
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Request understanding. Claude Haiku 5.5 is used first when set; Gemini is the backup; with neither,
# the browser's rule parser answers.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# optional: GEMINI_MODEL=gemini-3.5-flash-lite
# optional: LLM_DAILY_CAP=500

# Live suppliers (not wired yet; see README)
VIATOR_API_KEY=
VIATOR_BASE_URL=https://api.viator.com/partner
HOTELBEDS_ACTIVITIES_KEY=
HOTELBEDS_ACTIVITIES_SECRET=
HOTELBEDS_HOTELS_KEY=
HOTELBEDS_HOTELS_SECRET=
